---
import { brandAssets } from '@min-egenkontroll/brand';
import { resolveStaticThemeValue } from '@min-egenkontroll/design-system/theme';
import { internalRoadmap } from '../../config/internalRoadmap';
import '@min-egenkontroll/design-system/tokens.css';
import '@min-egenkontroll/design-system/base.css';

const themeColor = resolveStaticThemeValue('webThemeColor');

function durationHours(duration: { start: string; end?: string } | undefined): string | null {
  if (!duration?.end) return null;
  const start = new Date(duration.start).getTime();
  const end = new Date(duration.end).getTime();
  const hours = Math.max(1, Math.ceil((end - start) / 3_600_000));
  return `ca ${hours} h`;
}

function initialPhaseStatus(phase: (typeof internalRoadmap.phases)[number]) {
  if (phase.fixedCompletion === 'complete') return 'complete';
  if (phase.planned) return 'future';
  return 'unknown';
}

function initialStatusLabel(status: string) {
  if (status === 'complete') return 'Klar';
  if (status === 'future') return 'Framtida';
  return 'Status ej verifierad';
}

function initialStatusIcon(status: string) {
  if (status === 'complete') return '✓';
  if (status === 'future') return '○';
  return '?';
}
---
<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Intern visuell lägesrapport för Min Egenkontroll." />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="googlebot" content="noindex, nofollow, noarchive" />
    <meta name="theme-color" content={themeColor} />
    <link rel="icon" type="image/png" href={brandAssets.favicon} />
    <title>Projektroadmap | Min Egenkontroll</title>
    <script is:inline>
      (() => {
        const key = 'egenkontroll:homepage-theme';
        const saved = localStorage.getItem(key);
        const theme = saved === 'light' || saved === 'dark'
          ? saved
          : matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Hoppa till innehållet</a>

    <header class="roadmap-toolbar">
      <div class="roadmap-shell roadmap-toolbar__inner">
        <div>
          <strong>Min Egenkontroll</strong>
          <span>Intern projektroadmap</span>
        </div>
        <button class="theme-button" type="button" id="theme-toggle" aria-label="Växla ljust och mörkt tema">
          Växla tema
        </button>
      </div>
    </header>

    <main id="main-content" class="roadmap-shell roadmap-main">
      <section class="goal-panel" aria-labelledby="goal-title">
        <span class="eyebrow">{internalRoadmap.goal.eyebrow}</span>
        <h1 id="goal-title">{internalRoadmap.goal.title}</h1>
        <p>{internalRoadmap.goal.description}</p>
      </section>

      <section aria-labelledby="overview-title">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Lägesrapport</span>
            <h2 id="overview-title">Projektet i en blick</h2>
          </div>
          <div class="live-state" id="live-state" role="status" aria-live="polite" data-state="loading">
            <span class="status-dot" aria-hidden="true"></span>
            <span id="live-state-label">Verifierar status mot GitHub</span>
          </div>
        </div>

        <div class="metric-grid" id="metric-grid">
          <article class="metric-card">
            <span>Huvudspår just nu</span>
            <strong id="main-track-value">Status verifieras</strong>
            <small id="main-track-label">Ingen live-status visas innan GitHub-hämtningen är kontrollerad.</small>
          </article>
          <article class="metric-card">
            <span>Verifierat aktivt</span>
            <strong id="active-work-value">Status verifieras</strong>
            <small id="active-work-label">Aktivitet kräver labeln in-progress eller en explicit kopplad öppen PR.</small>
          </article>
          <article class="metric-card">
            <span>Nästa redo</span>
            <strong id="next-ready-value">Status verifieras</strong>
            <small id="next-ready-label">Första öppna och oblockerade issue enligt roadmapordningen.</small>
          </article>
          <article class="metric-card" id="blocker-card" hidden>
            <span>Öppna blockerare</span>
            <strong id="blocker-value">–</strong>
            <small id="blocker-label"></small>
          </article>
        </div>

        <p class="status-warning" id="status-warning" role="alert" hidden></p>
        <p class="updated-at" id="updated-at">Live-status har ännu inte verifierats.</p>
      </section>

      <section aria-labelledby="built-title">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Framsteg</span>
            <h2 id="built-title">Vad vi redan har byggt</h2>
          </div>
        </div>
        <div class="built-grid">
          {internalRoadmap.completedStory.map((item) => (
            <article class="built-card">
              <span class="check-mark" aria-hidden="true">✓</span>
              <div>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </section>

      <section aria-labelledby="roadmap-title">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Från strategi till kunder</span>
            <h2 id="roadmap-title">Transformationsroadmap</h2>
          </div>
          <p class="section-note">Strukturen är versionerad. Status, aktivitet, blockerare och nästa steg verifieras mot GitHub.</p>
        </div>

        <div class="phase-list" id="phase-list">
          {internalRoadmap.phases.map((phase) => {
            const status = initialPhaseStatus(phase);
            const duration = durationHours(phase.duration);
            return (
              <details
                class:list={['phase-card', `phase-card--${status}`]}
                data-phase-id={phase.id}
                open={false}
              >
                <summary>
                  <span class="phase-heading">
                    <span class="phase-icon" aria-hidden="true">{initialStatusIcon(status)}</span>
                    <strong>{phase.title}</strong>
                  </span>
                  <span class="phase-meta">
                    <span data-phase-status>{initialStatusLabel(status)}</span>
                    <span aria-hidden="true" data-phase-duration-separator hidden>·</span>
                    <span data-phase-duration hidden={!duration}>{duration ?? ''}</span>
                  </span>
                </summary>
                <div class="phase-content">
                  <p>{phase.summary}</p>
                  <ul>
                    {phase.points.map((point) => <li>{point}</li>)}
                  </ul>
                  <div class="current-marker" data-phase-marker hidden>
                    <span class="eyebrow" data-phase-marker-label>Huvudspår</span>
                    <span data-phase-marker-text></span>
                  </div>
                </div>
              </details>
            );
          })}
        </div>

        <p class="duration-note">{internalRoadmap.durationNote}</p>
      </section>

      <section aria-labelledby="related-title">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Beroenden och parallella behov</span>
            <h2 id="related-title">Relaterade spår</h2>
          </div>
          <p class="section-note">Dessa är uttryckligen konfigurerade och blandas inte automatiskt in i huvudspåret.</p>
        </div>
        <div class="track-grid" id="related-tracks">
          {internalRoadmap.relatedTracks.map((track) => (
            <article class="track-card" data-track-id={track.id}>
              <div class="track-card__heading">
                <span class="track-kind">{track.kind === 'separate' ? 'Separat produkt-/dataspår' : 'Roadmapberoende uppföljning'}</span>
                <span class="track-status" data-track-status>Status ej verifierad</span>
              </div>
              <h3>{track.title}</h3>
              <p>{track.description}</p>
              <strong data-track-issue>#{track.issueNumber}</strong>
              <small data-track-detail>Live-status verifieras mot GitHub.</small>
            </article>
          ))}
        </div>
      </section>

      <section class="destination-section" aria-labelledby="destination-title">
        <div class="destination-line" aria-hidden="true"></div>
        <div class="destination-card">
          <span class="destination-flag" aria-hidden="true">🏁</span>
          <span class="eyebrow">{internalRoadmap.destination.eyebrow}</span>
          <h2 id="destination-title">{internalRoadmap.destination.title}</h2>
          <p>{internalRoadmap.destination.description}</p>
          <div class="destination-checks">
            {internalRoadmap.destination.checks.map((check) => (
              <div><span aria-hidden="true">✓</span><strong>{check}</strong></div>
            ))}
          </div>
        </div>
        <div class="roadmap-end">
          <strong>Transformationsroadmapen slutar här.</strong>
          <span>Det finns inga fler faser i denna roadmap efter destinationen.</span>
        </div>
      </section>

      <section aria-labelledby="after-title">
        <div class="new-mode-divider" aria-hidden="true">
          <span></span><strong>Nytt arbetssätt börjar</strong><span></span>
        </div>
        <div class="after-card">
          <span class="section-kicker">Inte Fas 9</span>
          <h2 id="after-title">Efter roadmapen: löpande drift, utveckling och tillväxt</h2>
          <p>Detta är det normala arbetet i ett fungerande produktbolag, inte ännu en transformationsfas.</p>
          <div class="after-grid">
            {internalRoadmap.afterRoadmap.map((item) => (
              <article>
                <h3>{item.title}</h3>
                <p>{item.description}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section aria-labelledby="next-title">
        <div class="section-heading">
          <div>
            <span class="section-kicker">Närmaste vägen framåt</span>
            <h2 id="next-title">Nästa konkreta steg</h2>
          </div>
        </div>
        <ol class="next-steps" id="next-steps">
          <li class="next-step-placeholder">
            <span aria-hidden="true">?</span>
            <div>
              <strong>Status verifieras</strong>
              <p>Inga steg visas som aktuella innan GitHub-hämtningen är komplett.</p>
            </div>
          </li>
        </ol>
      </section>
    </main>

    <script>
      import { internalRoadmap } from '../../config/internalRoadmap';
      import {
        collectRequiredIssueNumbers,
        fetchRoadmapGitHubData,
        resolveRoadmapDisplay,
        type ResolvedRoadmapDisplay,
        type ResolvedRoadmapIssue,
        type RoadmapFetch,
      } from '../../lib/internalRoadmapStatus';

      const config = internalRoadmap;
      const phaseConfigById = new Map(config.phases.map((phase) => [phase.id, phase]));

      const browserFetch: RoadmapFetch = async (input, init) => await fetch(input, {
        method: 'GET',
        cache: init?.cache === 'no-cache' ? 'no-cache' : 'default',
        headers: init?.headers,
      });

      const formatHours = (duration: { start: string; end?: string } | undefined, completedAt: string | null, status: string) => {
        if (!duration) return null;
        const endValue = duration.end ?? completedAt ?? (status === 'active' || status === 'ready' || status === 'blocked' ? new Date().toISOString() : null);
        if (!endValue) return null;
        const start = new Date(duration.start).getTime();
        const end = new Date(endValue).getTime();
        const hours = Math.max(1, Math.ceil((end - start) / 3_600_000));
        return `ca ${hours} h${duration.end || completedAt ? '' : ' hittills'}`;
      };

      const statusIcon = (status: string) => {
        if (status === 'complete') return '✓';
        if (status === 'active') return '●';
        if (status === 'ready') return '→';
        if (status === 'blocked') return '◐';
        if (status === 'future') return '○';
        return '?';
      };

      const setLiveState = (kind: 'loading' | 'live' | 'warning', label: string) => {
        const state = document.getElementById('live-state');
        const stateLabel = document.getElementById('live-state-label');
        if (!state || !stateLabel) return;
        state.dataset.state = kind;
        stateLabel.textContent = label;
      };

      const issueText = (issue: ResolvedRoadmapIssue) => {
        const pr = issue.activePullRequestNumber ? ` · PR #${issue.activePullRequestNumber}` : '';
        return `#${issue.number}${pr}`;
      };

      const renderOverview = (display: ResolvedRoadmapDisplay) => {
        const mainValue = document.getElementById('main-track-value');
        const mainLabel = document.getElementById('main-track-label');
        if (mainValue) mainValue.textContent = display.mainTrack.label;
        if (mainLabel) {
          if (display.mainTrack.kind === 'multiple') {
            mainLabel.textContent = display.mainTrack.phaseIds
              .map((id) => phaseConfigById.get(id)?.title)
              .filter(Boolean)
              .join(' · ');
          } else if (display.mainTrack.kind === 'single') {
            mainLabel.textContent = phaseConfigById.get(display.mainTrack.phaseIds[0])?.summary ?? '';
          } else if (display.mainTrack.kind === 'complete') {
            mainLabel.textContent = 'Alla konfigurerade transformationsfaser är färdiga.';
          } else {
            mainLabel.textContent = 'GitHub-data räcker inte för ett säkert påstående.';
          }
        }

        const activeValue = document.getElementById('active-work-value');
        const activeLabel = document.getElementById('active-work-label');
        if (display.source === 'unverified' || !display.dataComplete) {
          if (activeValue) activeValue.textContent = 'Status ej verifierad';
          if (activeLabel) activeLabel.textContent = 'Ingen gammal fallback visas som aktiv.';
        } else if (display.activeIssues.length > 0) {
          if (activeValue) activeValue.textContent = display.activeIssues.map(issueText).join(', ');
          if (activeLabel) activeLabel.textContent = display.activeIssues.map((issue) => issue.title).join(' · ');
        } else {
          if (activeValue) activeValue.textContent = 'Inget aktivt issue markerat';
          if (activeLabel) activeLabel.textContent = 'Aktivitet kräver in-progress eller en explicit kopplad öppen PR.';
        }

        const nextValue = document.getElementById('next-ready-value');
        const nextLabel = document.getElementById('next-ready-label');
        if (display.source === 'unverified' || !display.dataComplete) {
          if (nextValue) nextValue.textContent = 'Status ej verifierad';
          if (nextLabel) nextLabel.textContent = 'Nästa redo visas först när all nödvändig data finns.';
        } else if (display.nextReady) {
          if (nextValue) nextValue.textContent = `#${display.nextReady.number}`;
          if (nextLabel) nextLabel.textContent = display.nextReady.title;
        } else {
          if (nextValue) nextValue.textContent = 'Inget redo issue';
          if (nextLabel) nextLabel.textContent = 'Inget öppet och oblockerat nästa steg kunde identifieras.';
        }

        const blockerCard = document.getElementById('blocker-card') as HTMLElement | null;
        const blockerValue = document.getElementById('blocker-value');
        const blockerLabel = document.getElementById('blocker-label');
        const showBlockers = display.source === 'github' && display.dataComplete && display.openBlockers.length > 0;
        if (blockerCard) blockerCard.hidden = !showBlockers;
        if (blockerValue) blockerValue.textContent = display.openBlockers.map((issue) => `#${issue.number}`).join(', ');
        if (blockerLabel) blockerLabel.textContent = display.openBlockers.map((issue) => issue.title).join(' · ');
      };

      const renderPhases = (display: ResolvedRoadmapDisplay) => {
        for (const phase of display.phases) {
          const element = document.querySelector<HTMLDetailsElement>(`[data-phase-id="${phase.id}"]`);
          if (!element) continue;
          element.classList.remove(
            'phase-card--complete',
            'phase-card--active',
            'phase-card--ready',
            'phase-card--blocked',
            'phase-card--future',
            'phase-card--unknown',
            'phase-card--current',
          );
          element.classList.add(`phase-card--${phase.status}`);
          const isMain = display.mainTrack.kind !== 'complete'
            && display.mainTrack.kind !== 'unknown'
            && display.mainTrack.phaseIds.includes(phase.id);
          if (isMain) element.classList.add('phase-card--current');
          if (isMain || phase.status === 'active') element.open = true;

          const label = element.querySelector<HTMLElement>('[data-phase-status]');
          const icon = element.querySelector<HTMLElement>('.phase-icon');
          const duration = element.querySelector<HTMLElement>('[data-phase-duration]');
          const separator = element.querySelector<HTMLElement>('[data-phase-duration-separator]');
          if (label) label.textContent = phase.statusLabel;
          if (icon) icon.textContent = statusIcon(phase.status);
          const durationText = formatHours(phaseConfigById.get(phase.id)?.duration, phase.completedAt, phase.status);
          if (duration) {
            duration.textContent = durationText ?? '';
            duration.hidden = !durationText;
          }
          if (separator) separator.hidden = !durationText;

          const marker = element.querySelector<HTMLElement>('[data-phase-marker]');
          const markerLabel = element.querySelector<HTMLElement>('[data-phase-marker-label]');
          const markerText = element.querySelector<HTMLElement>('[data-phase-marker-text]');
          if (!marker || !markerLabel || !markerText) continue;
          marker.hidden = true;
          if (phase.activeIssues.length > 0) {
            marker.hidden = false;
            markerLabel.textContent = 'Verifierat aktivt';
            markerText.textContent = phase.activeIssues.map((issue) => `${issueText(issue)} · ${issue.title}`).join(' | ');
          } else if (isMain && display.nextReady) {
            marker.hidden = false;
            markerLabel.textContent = 'Huvudspår';
            markerText.textContent = `Nästa redo: #${display.nextReady.number} · ${display.nextReady.title}`;
          } else if (phase.status === 'blocked' && phase.openBlockers.length > 0) {
            marker.hidden = false;
            markerLabel.textContent = 'Blockerad';
            markerText.textContent = `Väntar på ${phase.openBlockers.map((issue) => `#${issue.number}`).join(', ')}`;
          }
        }
      };

      const trackStatusLabel = (status: string) => {
        if (status === 'closed') return 'Klar';
        if (status === 'active') return 'Verifierat aktiv';
        if (status === 'blocked') return 'Blockerad';
        if (status === 'ready') return 'Redo';
        return 'Status ej verifierad';
      };

      const renderTracks = (display: ResolvedRoadmapDisplay) => {
        for (const track of display.relatedTracks) {
          const element = document.querySelector<HTMLElement>(`[data-track-id="${track.id}"]`);
          if (!element) continue;
          element.dataset.status = track.status;
          const status = element.querySelector<HTMLElement>('[data-track-status]');
          const issue = element.querySelector<HTMLElement>('[data-track-issue]');
          const detail = element.querySelector<HTMLElement>('[data-track-detail]');
          if (status) status.textContent = trackStatusLabel(track.status);
          if (issue) issue.textContent = track.issue ? `#${track.issue.number}` : 'Status ej verifierad';
          if (detail) {
            if (track.status === 'blocked') detail.textContent = `Blockeras av ${track.openBlockers.map((item) => `#${item.number}`).join(', ')}.`;
            else if (track.status === 'active' && track.issue) detail.textContent = `${track.issue.title}${track.issue.activePullRequestNumber ? ` · PR #${track.issue.activePullRequestNumber}` : ''}`;
            else if (track.issue) detail.textContent = track.issue.title;
            else detail.textContent = 'Live-status kunde inte verifieras.';
          }
        }
      };

      const renderNextSteps = (display: ResolvedRoadmapDisplay) => {
        const list = document.getElementById('next-steps');
        if (!list) return;
        list.replaceChildren();
        if (display.source === 'unverified' || !display.dataComplete) {
          const item = document.createElement('li');
          item.className = 'next-step-placeholder';
          const index = document.createElement('span');
          index.textContent = '?';
          const content = document.createElement('div');
          const title = document.createElement('strong');
          title.textContent = 'Status kunde inte verifieras';
          const text = document.createElement('p');
          text.textContent = 'Gamla eller ofullständiga steg visas inte som aktuella.';
          content.append(title, text);
          item.append(index, content);
          list.append(item);
          return;
        }
        if (display.nextSteps.length === 0) {
          const item = document.createElement('li');
          item.className = 'next-step-placeholder';
          const index = document.createElement('span');
          index.textContent = '✓';
          const content = document.createElement('div');
          const title = document.createElement('strong');
          title.textContent = 'Inga öppna huvudsteg identifierades';
          const text = document.createElement('p');
          text.textContent = 'Roadmapens konfigurerade huvudspår saknar ett öppet och oblockerat nästa steg.';
          content.append(title, text);
          item.append(index, content);
          list.append(item);
          return;
        }
        display.nextSteps.forEach((step, position) => {
          const item = document.createElement('li');
          const index = document.createElement('span');
          index.textContent = String(position + 1);
          const content = document.createElement('div');
          const title = document.createElement('strong');
          title.textContent = issueText(step);
          const text = document.createElement('p');
          text.textContent = step.title;
          content.append(title, text);
          item.append(index, content);
          list.append(item);
        });
      };

      const renderWarnings = (display: ResolvedRoadmapDisplay, fetchWarnings: readonly string[] = []) => {
        const warning = document.getElementById('status-warning') as HTMLElement | null;
        const messages = [...new Set([...display.warnings, ...fetchWarnings])];
        if (!warning) return;
        warning.hidden = messages.length === 0;
        warning.textContent = messages.join(' ');
      };

      const render = (display: ResolvedRoadmapDisplay, fetchWarnings: readonly string[] = []) => {
        renderOverview(display);
        renderPhases(display);
        renderTracks(display);
        renderNextSteps(display);
        renderWarnings(display, fetchWarnings);
      };

      const unverified = resolveRoadmapDisplay({
        repository: config.repository,
        phases: config.phases,
        tracks: config.relatedTracks,
        githubItems: null,
        dataComplete: false,
      });
      render(unverified);

      const loadGitHubStatus = async () => {
        const requiredIssueNumbers = collectRequiredIssueNumbers(config.phases, config.relatedTracks);
        const result = await fetchRoadmapGitHubData({
          repository: config.repository,
          requiredIssueNumbers,
          fetchImpl: browserFetch,
          maxPages: 10,
        });
        const display = resolveRoadmapDisplay({
          repository: config.repository,
          phases: config.phases,
          tracks: config.relatedTracks,
          githubItems: result.items,
          dataComplete: result.complete,
        });
        render(display, result.warnings);
        setLiveState(result.complete ? 'live' : 'warning', result.complete ? 'Verifierad mot GitHub' : 'Ofullständig GitHub-data');
        const updatedAt = document.getElementById('updated-at');
        if (updatedAt) {
          updatedAt.textContent = result.complete
            ? `Senast verifierad ${new Intl.DateTimeFormat('sv-SE', { dateStyle: 'medium', timeStyle: 'short' }).format(new Date())}.`
            : 'GitHub svarade, men all nödvändig data kunde inte verifieras.';
        }
      };

      loadGitHubStatus().catch(() => {
        render(unverified);
        setLiveState('warning', 'GitHub-status ej verifierad');
        const updatedAt = document.getElementById('updated-at');
        if (updatedAt) updatedAt.textContent = 'Live-status kunde inte hämtas. Ingen gammal status visas som aktuell.';
      });

      const themeButton = document.getElementById('theme-toggle');
      themeButton?.addEventListener('click', () => {
        const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = nextTheme;
        localStorage.setItem('egenkontroll:homepage-theme', nextTheme);
      });
    </script>
  </body>
</html>

<style>
  :global(*) { box-sizing: border-box; }
  :global(html) { background: var(--ds-canvas); }
  :global(body) {
    margin: 0;
    min-width: 320px;
    color: var(--ds-text);
    background: var(--ds-canvas);
    font-family: var(--ds-font-sans);
    font-size: var(--ds-font-size-base);
    line-height: var(--ds-line-height-base);
  }
  :global(button) { font: inherit; }
  :global(h1), :global(h2), :global(h3), :global(p) { margin-top: 0; }
  :global(h1), :global(h2), :global(h3) { line-height: var(--ds-line-height-tight); text-wrap: balance; }
  :global(a), :global(button), :global(summary) { -webkit-tap-highlight-color: transparent; }
  :global(:focus-visible) { outline: 3px solid var(--ds-focus); outline-offset: 3px; }

  .skip-link {
    position: absolute;
    top: var(--ds-space-3);
    left: var(--ds-space-3);
